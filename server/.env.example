APP_NAME=MediPharm
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.pharmacy.com.ng
APP_TIMEZONE=UTC
FRONTEND_URL=https://pharmacy.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

LOG_LEVEL=warning
DB_HOST=127.0.0.1
DB_DATABASE=cpaneluser_medipharm
DB_USERNAME=cpaneluser_mpuser
DB_PASSWORD=

SESSION_DOMAIN=.pharmacy.com.ng
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=pharmacy.com.ng,www.pharmacy.com.ng

MAIL_MAILER=smtp
MAIL_HOST=mail.pharmacy.com.ng
MAIL_PORT=465
MAIL_USERNAME=noreply@pharmacy.com.ng
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@pharmacy.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Nightly mysqldump target, outside public_html
MEDIPHARM_BACKUP_PATH=/home/cpaneluser/backups/medipharm
MEDIPHARM_TRIAL_DAYS=30
